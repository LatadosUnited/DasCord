# Copie para .env e ajuste conforme necessário

# Servidor Rust (padrão: http://localhost:3001). O WebSocket é derivado daqui.
# Se mudar, atualize também o connect-src da CSP em src-tauri/tauri.conf.json.
VITE_API_URL=http://localhost:3001
# VITE_WS_URL=ws://localhost:3001/ws

# Relay TURN para voz atrás de NAT restritivo (ex: coturn). Várias URLs separadas por vírgula.
# VITE_TURN_URL=turn:turn.exemplo.com:3478?transport=udp,turn:turn.exemplo.com:3478?transport=tcp
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=

# --- Voz: servidor de mídia (SFU) ---
# Com as três variáveis abaixo, a voz passa pelo LiveKit: cada pessoa envia o áudio
# uma vez só, em vez de mandar uma cópia para cada participante (malha P2P).
# Sem elas, o servidor responde 503 em /api/voice/token e o app usa P2P.
# Antes de subir o SFU, crie o arquivo de chaves (ele fica fora do git):
#   cp livekit/livekit.yaml.example livekit/livekit.yaml
#   docker run --rm livekit/livekit-server generate-keys
#   docker compose -f livekit/docker-compose.yml up -d
# Use aqui o MESMO par que ficou em keys: do livekit.yaml. O segredo fica só no
# servidor Rust; o app recebe um token temporário por canal.
# LIVEKIT_URL=ws://localhost:7880
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# --- Variáveis do servidor (server/) ---
# Regras de entrada. Os padrões abaixo são os de desenvolvimento (tudo aberto).
# Numa instalação exposta à internet, use: convite obrigatório, sem convidado
# anônimo e sem entrada automática no servidor padrão.
# DASCORD_REQUIRE_INVITE=1     # cadastro só com código de convite válido
# DASCORD_ALLOW_GUESTS=0       # desliga a entrada como convidado (sessão de 24h)
# DASCORD_AUTO_JOIN_DEFAULT=0  # quem chega entra só no servidor de quem convidou
# DASCORD_BEHIND_PROXY=1       # há proxy reverso na frente: o IP real vem em X-Forwarded-For.
                               # Só ligue com o proxy mesmo na frente, senão o IP vira falsificável
                               # e os limites por endereço deixam de valer.

# DASCORD_BIND=127.0.0.1:3001            # use 0.0.0.0:3001 para aceitar conexões da rede
# DASCORD_PUBLIC_URL=http://localhost:3001 # endereço usado nas URLs dos avatares enviados
# DASCORD_DATA_DIR=server/data            # banco de dados e avatares
# DASCORD_SIGNING_SECRET=       # assina o endereço temporário das imagens do chat.
                                # Sem ela, o servidor gera e guarda um signing.key ao lado
                                # do banco, legível só pelo dono. Trocá-la invalida na hora
                                # os endereços que já estavam abertos na tela.

# DASCORD_ALLOWED_ORIGINS=http://localhost:1420,http://tauri.localhost,https://tauri.localhost,tauri://localhost
